#Loading packages
library(rbiom)
library(phyloseq)
library(vegan)
library(dplyr)
library(tidyr)
library(data.table)

# setting library paths
MIDLOCMicrobiome_biompath <- "04_cleaned_MIDLOC.biom"

# import biom file into R
MIDLOC_microbiomedata <- as_rbiom(MIDLOCMicrobiome_biompath)
MIDLOC_microbiomedata

#create an otu_table 
otu_table <- as.matrix(MIDLOC_microbiomedata$counts)
View(otu_table)

names(MIDLOC_microbiomedata$metadata)[2] <- "group"

#normalize by the root since certain count were removed
library(slam)
features_table <- MIDLOC_microbiomedata$counts
col_sums <- col_sums(features_table)
features_table_norm <- features_table
features_table_norm$v <- features_table_norm$v/col_sums[features_table$j]
col_sums(features_table_norm)
MIDLOC_microbiomedata$counts <- features_table_norm

#adding metadata
metadata <- MIDLOC_microbiomedata$metadata

#subsetting to only people with MD
MIDLOC_microbiomedata_MD <- subset(MIDLOC_microbiomedata, `group` %in% c('MD'))
metadata_MD <- MIDLOC_microbiomedata_MD$metadata

# Correlation analysis alpha diversity
library(ggplot2)

#making a corplot and cor test manually
MIDLOC_microbiomedata_MD_shannon <- adiv_table(MIDLOC_microbiomedata_MD, adiv = "shannon")
df <- data.frame(
  Nmdas = MIDLOC_microbiomedata_MD$metadata$nmdas,
  Adiv = MIDLOC_microbiomedata_MD_shannon$.diversity
)

# Create a raw scatter plot
ggplot(df, aes(x = Nmdas, y = Adiv)) +
  geom_point(size = 4, color = "red") + 
  geom_smooth(method = "lm") +
  labs(title = "Manual Check of Data Points")

cor.test(df$Nmdas, df$Adiv, method = "spearman")


library(corrplot)

#looking at all the variables and alpha diversity
cor_alpha_MD <- MIDLOC_microbiomedata_MD_shannon
cor_alpha_MD <- cor_alpha_MD[, sapply(cor_alpha_MD, is.numeric)]
cor_alpha_MD$.depth <- NULL
cor_alpha_MD$sex_code <- NULL
cor_alpha_MD$diabetes_code <- NULL
cor_alpha_MD$probiotica <- NULL
row.names(cor_alpha_MD) <- metadata_MD$.sample

cor_matrix_alpha <- cor(cor_alpha_MD, method = "spearman", use = "pairwise.complete.obs")
res_sig <- cor.mtest(cor_alpha_MD, conf.level = 0.95, method = "spearman")

Alpha_correlation_table <- data.frame(
  row.names = row.names(cor_matrix_alpha),
  correlation = cor_matrix_alpha[,".diversity"],
  p_value = res_sig$p[, ".diversity"]
)

Alpha_correlation_table$FDR <- p.adjust(Alpha_correlation_table$p_value, method = "fdr")


# making a species table
long_df <- taxa_table(MIDLOC_microbiomedata_MD, rank = "Species", unc = "drop", taxa = 0.00000001)

# Pivot to wide format
cor_species <- long_df %>%
  select(.sample, .taxa, .abundance) %>%
  pivot_wider(names_from = .taxa, values_from = .abundance)

# Convert to data frame and set row names
cor_species <- as.data.frame(cor_species)
rownames(cor_species) <- cor_species$.sample
cor_species$.sample <- NULL

# creating a data.frame with all the numerical data
cor_metadata_MD <- metadata_MD
cor_metadata_MD <- cor_metadata_MD[, sapply(cor_metadata_MD, is.numeric)]
cor_metadata_MD$sex_code <- NULL
cor_metadata_MD$diabetes_code <- NULL
cor_metadata_MD$probiotica <- NULL
row.names(cor_metadata_MD) <- metadata_MD$.sample

# Calculate matrix
cor_matrix <- cor(cor_species, cor_metadata_MD, method = "spearman", use = "pairwise.complete.obs")

#saving it as csv file
write.csv(cor_matrix, "cor_matrix_microbial.csv")

#calculate significance
combined_data <- cbind(cor_species, cor_metadata_MD)
res_sig <- cor.mtest(combined_data, conf.level = 0.95, method = "spearman")

# Using only the variables as columns for the correlation
taxa_names <- colnames(cor_species)
meta_names <- colnames(cor_metadata_MD)

p_raw_rect <- res_sig$p[taxa_names, meta_names]

#saving it as csv file
write.csv(p_raw_rect, "cor_p-values_microbial.csv")

#calculating the adjusted p-value
p_rect_adj <- matrix(NA, nrow = length(taxa_names), ncol = length(meta_names))
rownames(p_rect_adj) <- taxa_names
colnames(p_rect_adj) <- meta_names

# Loop through each metadata variable and adjust p-values independently
for (m_col in meta_names) {
  
  # Extract raw p-values for all taxa against this one metadata column
  raw_p_col <- res_sig$p[taxa_names, m_col]
  
  # Apply FDR (Benjamini-Hochberg) to just this vector
  adj_p_col <- p.adjust(raw_p_col, method = "fdr")
  
  # Put them back into our rectangular matrix
  p_rect_adj[, m_col] <- adj_p_col
}

#saving it as csv file
write.csv(p_rect_adj, "cor_FDR_microbial.csv")


# Create the plot

# setting library paths
MIDLOCMicrobiome_biompath <- 

# import biom file into R
MIDLOCMicrobiome_biomdata <- as_rbiom(MIDLOCMicrobiome_biompath)
MIDLOCMicrobiome_biomdata

#changing type to group
names(MIDLOCMicrobiome_biomdata$metadata)[2] <- "group"

#normalize by the root since certain count were removed
features_table <- MIDLOCMicrobiome_biomdata$counts
col_sums <- col_sums(features_table)
features_table_norm <- features_table
features_table_norm$v <- features_table_norm$v/col_sums[features_table$j]
col_sums(features_table_norm)
MIDLOCMicrobiome_biomdata$counts <- features_table_norm

#create an otu_table 
otu_table <- as.matrix(MIDLOCMicrobiome_biomdata$counts)

#splitting the biom file in only MD
MIDLOC_microbiomedata_MD <- subset(MIDLOCMicrobiome_biomdata, MIDLOCMicrobiome_biomdata$metadata$group == "MD")
MIDLOC_microbiomedata_MD

#looking at the difference between high and low NMDAS
metadata_MD <- MIDLOC_microbiomedata_MD$metadata
metadata_MD$nmdas_factor <- ifelse(metadata_MD$nmdas > 20, "severe", "mild")
MIDLOC_microbiomedata_MD$metadata <- metadata_MD

#betadisper to look if variance could be a possible cofounder
out_table_MD <- as.matrix(MIDLOC_microbiomedata_MD$counts)
dist_matrix_MD <- vegdist(t(out_table_MD), method = "bray")
pcoa_results_vegdist_MD <- cmdscale(dist_matrix_MD, k=3)
pcoa_results_vegdist_eigenvalue_MD <- cmdscale(dist_matrix_MD, k=2, eig = TRUE)
pcoa_df_vegdist_MD <- data.frame(PCoA1 = pcoa_results_vegdist_MD[,1], PCoA2 = pcoa_results_vegdist_MD[,2], PCoA3 = pcoa_results_vegdist_MD[,3], eigenvalues = pcoa_results_vegdist_eigenvalue_MD$eig, SampleID = rownames(pcoa_results_vegdist_MD), SampleGroup = sample_data(MIDLOC_microbiomedata_MD$metadata))
colnames(pcoa_df_vegdist_MD) <- sub("^SampleGroup\\.", "", colnames(pcoa_df_vegdist_MD))
bd_MD <- betadisper(dist_matrix_MD, MIDLOC_microbiomedata_MD$metadata$nmdas_factor)
anova(bd_MD)
permutest(bd_MD)

#looking at the beta-diversity between high and low NMDAS
bdiv_ord_plot(MIDLOC_microbiomedata_MD, bdiv = "Bray-Curtis", ord = "PCoA", stat.by = "nmdas_factor", layers = "pe", unc = "drop") + geom_text(aes(label = MIDLOC_microbiomedata_MD$metadata$nmdas))

#eigenvalues and percentage of variance
eigenvalues <- pcoa_results_vegdist_eigenvalue_MD$eig
total_variance <- sum(eigenvalues)
pcoa_variance <- as.data.frame(eigenvalues, row.names = paste0("PC", 1:30))
pcoa_variance$variance <- pcoa_variance$eigenvalues/total_variance
pcoa_variance$percentage <- pcoa_variance$variance*100
pcoa_variance$percentage <- lapply(pcoa_variance$percentage, function(x) sprintf("%.1f", x))
View(pcoa_variance)            

#adding the centroids of all pcoa
centroids_MD <- pcoa_df_vegdist_MD %>%
  group_by(pcoa_df_vegdist_MD$nmdas_factor) %>%
  summarise(
    PC1 = mean(PCoA1),
    PC2 = mean(PCoA2),
    PC3 = mean(PCoA3))

colnames(centroids_MD)[1] <- "nmdas_factor"
colnames(pcoa_df_vegdist_MD)[27] <- "nmdas_factor"
bdiv_microbial<- ggplot(pcoa_df_vegdist_MD, aes(x = PCoA1, y = PCoA2, color = nmdas_factor))+
  geom_point(size = 1, alpha = 0.8)+
  theme_minimal()+
  geom_point(data = centroids_MD, aes(x = PC1, y = PC2),
             shape = 18, size = 3)+
  stat_ellipse(type = "t", linetype = 1, alpha = 1)+
  xlab( paste("PC1,", pcoa_variance$percentage[1] , "% Dissimilarity")) + ylab( paste("PC2,", pcoa_variance$percentage[2] , "% Dissimilarity"))+
  theme(legend.direction = "horizontal")+
  theme(
    axis.title.x = element_text(size = 14),  
    axis.title.y = element_text(size = 14),
    legend.text = element_text(size = 14),
    legend.title = element_text(size = 16))+
  ggtitle("Weighted Bray-Curtis PCoA (Microbial)")
bdiv_microbial <- bdiv_microbial + theme(legend.position= "bottom")
bdiv_microbial

set.seed(123)
nmdas_permanova <- adonis2(dist_matrix_MD ~ nmdas_factor, data = pcoa_df_vegdist_MD, permutations = 99999)
nmdas_permanova

pcoa_df_vegdist_MD$nmdas_factor <- as.vector(pcoa_df_vegdist_MD$nmdas_factor)
pairwiseadonis_table <- pairwise_adonis(dist_matrix_MD, pcoa_df_vegdist_MD$nmdas_factor, perm = 99999)
pairwiseadonis_table

